# FOFA credentials. Keep real values in this project's local .env only.
# Optional: absolute path or path relative to the project root.
# FOFA_ENV_FILE=
FOFA_EMAIL=
FOFA_KEY=
FOFA_EMAIL_BACKUP=
FOFA_KEY_BACKUP=
FOFA_EMAIL_BACKUP2=
FOFA_KEY_BACKUP2=

# Optional runtime policy.
FOFA_API_BASE=https://fofa.info/api/v1
FOFA_TIMEOUT_SEC=30
FOFA_DEFAULT_PAGE_SIZE=100
FOFA_MAX_PAGE_SIZE=200
FOFA_MAX_CURSOR_PAGES=20
FOFA_MAX_REQUESTS_PER_SESSION=100
FOFA_MAX_ESTIMATED_FPOINTS=30
FOFA_MAX_TOTAL_RESULTS=2000
FOFA_MAX_QUERY_LENGTH=4096
FOFA_MAX_RETRIES=2
FOFA_MAX_HOST_RESPONSE_BYTES=2000000
FOFA_LOG_LEVEL=INFO
